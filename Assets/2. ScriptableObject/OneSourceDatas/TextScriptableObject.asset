--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: de9fa79b624027848b0f0d9d71e4c7af, type: 3}
  m_Name: TextScriptableObject
  m_EditorClassIdentifier: 
  messageboxText:
  - "\uC800\uC7A5\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB807\uAC8C \uC9C4\uD589\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB300\uB85C \uC9C4\uD589\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - "\uB9E4\uCE6D\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
  - "\uC720\uD6A8\uD558\uC9C0 \uC54A\uC740 \uAE00\uC790\uAC00 \uD3EC\uD568\uB418\uC5B4
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC218\uC815\uD55C \uB0B4\uC6A9\uC744 \uC0AD\uC81C\uD558\uACE0 \uCC3D\uC744
    \uB2EB\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - "\uC218\uC815\uD55C \uB0B4\uC6A9\uC744 \uC800\uC7A5\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  explainText:
  - title: "\uACC4\uC57D\uAE08"
    details: "\uD30C\uD2F0\uAC00 \uC131\uB140\uB97C \uACE0\uC6A9\uD558\uAE30 \uC704\uD574
      \uC9C0\uBD88\uD558\uB294 \uACC4\uC57D\uAE08."
  - title: "\uC815\uC0B0\uAE08"
    details: "\uBAA8\uB4E0 \uC801\uC744 \uCC98\uCE58\uD588\uC744 \uB54C \uBD84\uBC30\uBC1B\uB294
      \uC804\uB9AC\uD488."
  - title: "\uC601\uC6C5"
    details: "\uB2F9\uC2E0\uC5D0\uAC8C \uACC4\uC57D\uAE08\uC744 \uC9C0\uBD88\uD558\uACE0
      \uCE58\uB8CC\uB97C \uBD80\uD0C1\uD55C \uD638\uAD6C\uB4E4\uC785\uB2C8\uB2E4."
  - title: "\uBAAC\uC2A4\uD130"
    details: "\uD30C\uD2F0\uAC00 \uC0AC\uB0E5\uD560 \uB300\uC0C1\uC73C\uB85C \uC804\uB9AC\uD488\uC740
      \uBC30\uBD84\uCE58\uC5D0 \uB530\uB77C \uB098\uB220 \uAC16\uC2B5\uB2C8\uB2E4."
  - title: "\uAC15\uD654"
    details: "\uC131\uB140\uB85C\uC11C\uC758 \uB2A5\uB825\uC744 \uAC15\uD654\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - title: "\uC801 \uCD94\uAC00"
    details: "\uC804\uD22C \uC911\uC778 \uACBD\uC7C1\uC790\uC5D0\uAC8C \uC804\uD22C\uC5D0\uC11C
      \uCC98\uCE58\uD55C \uB4F1\uAE09\uC758 \uC720\uB2DB\uC744 \uCD94\uAC00\uD569\uB2C8\uB2E4."
  - title: "\uC801 \uAC15\uD654"
    details: "\uC804\uD22C \uC911\uC778 \uC801\uC5D0\uAC8C \uACF5\uACA9\uB825\uC744
      \uC77C\uC815\uBE44\uC728 \uC99D\uAC00\uC2DC\uD0A4\uB294 \uBC84\uD504\uB97C
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
  - title: "\uC601\uC6C5 \uC57D\uD654"
    details: "\uC804\uD22C \uC911\uC778 \uD30C\uD2F0\uC5D0\uAC8C \uC804\uCCB4 \uCCB4\uB825\uC758
      \uC77C\uC815 \uBE44\uC728\uC758 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
  - title: "\uACBD\uB9E4"
    details: "\uCD5C\uACE0 \uC785\uCC30\uC790\uB294 \uB099\uCC30\uBC1B\uACE0, \uCC28\uAE30
      \uC785\uCC30\uC790\uB294 \uCD94\uAC00 \uBCF4\uC0C1\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
  - title: "\uACBD\uB9E4\uBB3C\uD488"
    details: "\uCD9C\uD488\uB41C \uC544\uC774\uD15C\uC740 \uB9E4\uCE6D \uC804 \uAC01
      \uD50C\uB808\uC774\uC5B4\uB4E4\uC774 \uC124\uC815\uD55C \uC544\uC774\uD15C
      \uBAA9\uB85D\uC5D0\uC11C \uB098\uC635\uB2C8\uB2E4."
  - title: "\uC18C\uC9C0\uD488"
    details: "\uC804\uD22C \uC544\uC774\uD15C\uC740 \uC790\uB3D9\uC73C\uB85C \uC0AC\uC6A9\uB418\uACE0,
      \uC778\uBCA4\uD1A0\uB9AC\uAC00 \uAC00\uB4DD \uCC28\uBA74 \uACBD\uB9E4\uC5D0
      \uCC38\uC5EC\uD560 \uC218\uB294 \uC788\uC9C0\uB9CC \uB099\uCC30\uBC1B\uC544\uB3C4
      \uB3C8\uB9CC \uC783\uB294\uB2E4."
